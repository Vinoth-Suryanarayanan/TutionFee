# Copy to .env and adjust. .env is git-ignored.

# Database (Postgres comes in Step 2)
DATABASE_URL=postgresql+psycopg://tuition:tuition@localhost:5432/tuition

# School / billing settings — make it yours
SCHOOL_NAME="Example Learning Center"
CURRENCY=USD
BILLING_DUE_DAY=5
# full_month_if_enrolled_any_day | full_month_if_enrolled_on_first
BILLING_POLICY=full_month_if_enrolled_any_day
# Remind only when the unpaid balance is at least this amount
REMINDER_MIN_BALANCE=1.00

# Where real statement CSVs live (git-ignored). Mock data lives in data/mock.
PRIVATE_DATA_DIR=data/private
